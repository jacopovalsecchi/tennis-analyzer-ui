# Public client config. Copy this file to .env.
# Use the Supabase publishable key. Do not put a secret or service-role key here.
#
# BACKEND_URL is the Node API. The iOS simulator can use localhost.
# On the Android emulator, localhost is rewritten to 10.0.2.2.
# On a phone, use this computer's LAN address, for example http://192.168.1.10:3001.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
BACKEND_URL=http://localhost:3001
